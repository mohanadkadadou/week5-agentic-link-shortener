#!/usr/bin/env bash
# Blocks the commit if lint, formatting or tests fail. Enable with:
#   git config core.hooksPath .githooks
# Bypassing it (--no-verify) is forbidden by AGENTS.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! scripts/check.sh; then
  echo "" >&2
  echo "pre-commit: BLOCKED. Fix the failures above, then commit again." >&2
  exit 1
fi
